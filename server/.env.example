# Required: generate with `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`
AUTH_TOKEN=

# Server bind address (default: 127.0.0.1 for local only, use 0.0.0.0 for remote)
HOST=127.0.0.1
PORT=9100

# Claude model
MODEL=claude-sonnet-4-6

# Permission mode (bypassPermissions = no interactive approval needed)
PERMISSION_MODE=bypassPermissions

# Working directory for Claude (optional, defaults to server directory)
# CWD=/Users/you/projects

# Path to Claude CLI binary (optional, auto-detected if on PATH)
# CLAUDE_CLI_PATH=/path/to/claude
