{
  "name": "jac-desktop",
  "productName": "JAC",
  "version": "0.3.1",
  "description": "JAC AI Workbench — Desktop",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "webpack --config webpack.main.js --mode production",
    "build:preload": "webpack --config webpack.preload.js --mode production",
    "build:renderer": "webpack --config webpack.renderer.js --mode production",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "set ELECTRON_RUN_AS_NODE=& electron . --remote-debugging-port=9222",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.4",
    "@uiw/codemirror-themes-all": "^4.25.10",
    "codemirror": "^6.0.2",
    "dockview-core": "^7.0.2",
    "electron-updater": "^6.8.9",
    "three": "^0.128.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/ws": "8.18.1",
    "copy-webpack-plugin": "12.0.2",
    "electron": "32.3.3",
    "electron-builder": "24.13.3",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.108.1",
    "webpack-cli": "5.1.4"
  }
}
