{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "dist/preload",
    "rootDir": "src/main",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/main/preload.ts"]
}
